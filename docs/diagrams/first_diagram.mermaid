flowchart LR
    user([User]) --> onboarding(onboarding)
    onboarding --> composicion(composicion definida)
    composicion --> accept{Accept}

    accept -->|true| extraccion(extraccion)
    extraccion --> inversion(inversion)

    accept -->|false| definir(definir composicion)
    definir --> extraccion

    ia(ia) -->|Advice / insight| definir
    definir --> ia

    onboarding -.-> perfil["- Perfil de Inversor (mediante<br/>preguntas estructuradas)<br/>- Edad (o PII)<br/>- Interes (VO PII)<br/>- Meta (jubilacion, corto plazo, etc.)<br/>- Activo, % de riesgo (y valor fijo)"]

    classDef actor fill:#ffffff,stroke:#64748b,stroke-width:1.5px,color:#111827;
    classDef step fill:#f8fbff,stroke:#334155,stroke-width:1.8px,color:#0f172a;
    classDef decision fill:#fffaf0,stroke:#334155,stroke-width:1.8px,color:#0f172a;
    classDef ai fill:#f3f0ff,stroke:#6d28d9,stroke-width:1.8px,color:#3b0764;
    classDef note fill:#fffef7,stroke:#cbd5e1,stroke-dasharray: 4 3,color:#334155;
    classDef outcome fill:#f7fbf8,stroke:#334155,stroke-width:1.8px,color:#0f172a;

    class user actor;
    class onboarding,composicion,extraccion,definir step;
    class accept decision;
    class ia ai;
    class perfil note;
    class inversion outcome;

    linkStyle 0 stroke:#475569,stroke-width:2px;
    linkStyle 1 stroke:#475569,stroke-width:2px;
    linkStyle 2 stroke:#2563eb,stroke-width:2.4px;
    linkStyle 3 stroke:#475569,stroke-width:2px;
    linkStyle 4 stroke:#dc2626,stroke-width:2.4px;
    linkStyle 5 stroke:#475569,stroke-width:2px;
    linkStyle 6 stroke:#7c3aed,stroke-width:2px;
    linkStyle 7 stroke:#7c3aed,stroke-width:2px;
    linkStyle 8 stroke:#94a3b8,stroke-width:1.5px,stroke-dasharray: 4 3;
