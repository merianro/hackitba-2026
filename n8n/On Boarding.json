    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet context = {};\ntry { context = JSON.parse(data.context || '{}'); } catch(e) {}\ncontext.p7 = data.message;\n\nconst extractScore = (val) => {\n  if (!val) return 1;\n  const parts = val.split('_');\n  return parseInt(parts[parts.length - 1]) || 1;\n};\n\nconst scores = [\n  extractScore(context.p1),\n  extractScore(context.p2),\n  extractScore(context.p3),\n  extractScore(context.p4),\n  extractScore(context.p5),\n  extractScore(context.p6),\n  extractScore(context.p7)\n];\n\nconst avg = scores.reduce((a, b) => a + b, 0) / scores.length;\n\nlet profile;\nif (avg <= 1.8) profile = 'Conservador';\nelse if (avg <= 2.6) profile = 'Moderado';\nelse if (avg <= 3.4) profile = 'Crecimiento';\nelse profile = 'Agresivo';\n\nconst emoji = {Conservador:'🛡️', Moderado:'⚖️', Crecimiento:'📈', Agresivo:'🚀'}[profile];\nconst profileScore = Math.round(avg * 100) / 100;\n\nconst completionText = '¡Listo, ' + data.user_name + '! 🎉\\n\\nCompletaste tu perfil inversor.\\n\\nTu perfil es: *' + profile + '* ' + emoji + '\\n\\nYa podés consultarme sobre tu portafolio, inversiones y mucho más. ¡Estoy aquí para ayudarte! 💼';\n\nreturn [{\n  json: {\n    phone_number_id: data.phone_number_id,\n    sender_phone_number: data.sender_phone_number,\n    to: data.sender_phone_number,\n    user_name: data.user_name,\n    investor_profile: profile,\n    profile_score: profileScore,\n    newContext: JSON.stringify(context),\n    nextStatus: 1,\n    text: completionText\n  }\n}];"
      },
