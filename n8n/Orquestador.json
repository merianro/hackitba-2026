    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Merge inteligente\nconst merged = items.reduce((acc, item) => {\n  const data = item.json;\n\n  Object.keys(data).forEach(key => {\n    if (data[key] !== null && data[key] !== undefined) {\n      acc[key] = data[key];\n    }\n  });\n\n  return acc;\n}, {});\n\n// Asegurar campos finales\nmerged.conversationStatus = merged.conversationStatus ?? 0;\nmerged.context = merged.context ?? null;\n\nreturn [\n  {\n    json: merged\n  }\n];"
      },
